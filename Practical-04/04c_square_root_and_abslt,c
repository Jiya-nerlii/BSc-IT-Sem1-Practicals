#include <stdio.h>
#include <math.h>
#include <stdlib.h>

int main() {
    double num, squareRoot;
    int negNum, absoluteVal;

    // Finding square root using sqrt() from math.h
    printf("Enter a positive number to find its square root: ");
    scanf("%lf", &num);
    squareRoot = sqrt(num);
    printf("Square root of %.2lf = %.2lf\n\n", num, squareRoot);

    // Finding absolute value using abs() from stdlib.h
    printf("Enter a negative integer to find its absolute value: ");
    scanf("%d", &negNum);
    absoluteVal = abs(negNum);
    printf("Absolute value of %d = %d\n", negNum, absoluteVal);

    return 0;
}

/*
Sample Output:
Enter a positive number to find its square root: 49
Square root of 49.00 = 7.00

Enter a negative integer to find its absolute value: -25
Absolute value of -25 = 25
